# Required: Anthropic API key (server-side only)
ANTHROPIC_API_KEY=sk-ant-...

# ──────────────────────────────────────────────────────────────────────────
# Microsoft SSO (Nyenrode tenant) — leave AUTH_ENABLED=false for open access
# ──────────────────────────────────────────────────────────────────────────

# Set to "true" to require sign-in. Anything else = open access (testing).
AUTH_ENABLED=false

# Required by Auth.js for signing JWT session cookies.
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# From the Azure App Registration in Nyenrode's Entra tenant
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=

# ──────────────────────────────────────────────────────────────────────────
# Embedding (iframe)
# ──────────────────────────────────────────────────────────────────────────
# Comma- or space-separated origins allowed to embed Gaston via iframe.
# Leave empty to allow any site (recommended only for testing).
# EMBED_ALLOWED_ORIGINS=https://learn.nyenrode.nl https://canvas.nyenrode.nl
EMBED_ALLOWED_ORIGINS=
